{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "lielalmog",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  "preview_urls": false,
}
