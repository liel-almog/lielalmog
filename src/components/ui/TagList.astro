---
interface Props {
  items: readonly string[];
  label: string;
  inverted?: boolean;
  class?: string;
}
const { items, label, inverted = false, class: className } = Astro.props;
---

<ul class:list={['m-0 min-w-0 flex list-none flex-wrap gap-1.75 p-0', className]} aria-label={label}>
  {items.map((item) => (
    <li class:list={[
      'max-w-full wrap-anywhere border px-2.25 py-1 text-[10px] leading-[1.65] max-[760px]:text-xs',
      inverted ? 'border-[#647461] text-[#d5ded0]' : 'border-[#cdd2c6]',
    ]}>{item}</li>
  ))}
</ul>
