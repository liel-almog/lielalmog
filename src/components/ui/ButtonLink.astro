---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  arrow?: string;
  target?: '_blank';
  resumeDialog?: boolean;
}

const { href, variant = 'secondary', arrow, target, resumeDialog = false } = Astro.props;
const variants = {
  primary: 'border-brand bg-brand text-white hover:bg-brand-hover hover:text-white',
  secondary: 'border-[#b7beb2] hover:bg-surface-light',
};
---

<a
  class:list={[
    'inline-flex max-w-full min-h-12.5 max-[480px]:w-full items-center justify-between gap-6 border px-5 py-3 text-[13px] font-semibold',
    variants[variant],
  ]}
  href={href}
  target={target}
  rel={target === '_blank' ? 'noopener noreferrer' : undefined}
  data-resume-dialog={resumeDialog ? '' : undefined}
>
  <slot />
  {arrow && <span class="shrink-0" aria-hidden="true">{arrow}</span>}
</a>
