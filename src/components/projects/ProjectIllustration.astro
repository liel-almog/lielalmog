---
interface Props { projectId: string; index: number; }
const { projectId, index } = Astro.props;
const labels: Record<string, { category: string; flow: string }> = {
  ebpf: { category: 'SECURITY', flow: 'POLICY → ENFORCEMENT' },
  'algo-studio': { category: 'ALGORITHMS', flow: 'INPUT → SEARCH → SOLUTION' },
  vulnerability: { category: 'DEVELOPER TOOLS', flow: 'DEPENDENCIES → KNOWN RISKS' },
};
const label = labels[projectId];
---

<div class="flex min-w-0 min-h-77.5 flex-col justify-between bg-brand-soft bg-[radial-gradient(#a6baa323_.8px,transparent_.8px)] bg-size-[15px_15px] p-5.5 max-[760px]:min-h-67.5" aria-hidden="true">
  <div class="flex justify-between gap-3 font-mono text-[8px] leading-normal tracking-[.05em] text-on-brand">
    <span>{String(index + 1).padStart(2, '0')} / SYSTEM STUDY</span>
    <span>{label.category}</span>
  </div>
  {projectId === 'ebpf' ? (
    <div class="flex flex-col items-center gap-1.25 p-6 max-[400px]:px-0">
      {['CONTROL PLANE', 'GO HOST AGENT', 'C / eBPF KERNEL'].map((layer, i) => (
        <Fragment>
          {i > 0 && <span class="leading-none text-[#c6d6b6]">↓</span>}
          <div class:list={[
            'w-full max-w-55 border border-[#95ad8c] p-2.5 text-center font-mono text-[10px] leading-normal tracking-[.08em]',
            i === 2 ? 'bg-[#c6d6b6] text-brand' : 'bg-brand-soft',
          ]}>{layer}</div>
        </Fragment>
      ))}
    </div>
  ) : projectId === 'algo-studio' ? (
    <div class="m-5.5 grid grid-cols-[repeat(3,52px)] gap-1.25 self-center">
      {['1', '2', '3', '4', '5', '6', '7', '8', '↗'].map((n, i) => (
        <span class:list={[
          'grid h-12 place-items-center font-serif text-[22px] leading-normal',
          i === 8 ? 'bg-[#a85b3c] text-white' : 'bg-[#c6d6b6] text-brand',
        ]}>{n}</span>
      ))}
    </div>
  ) : (
    <div class="my-6.25 mx-2 grid min-w-0 justify-items-center gap-1.75 font-mono text-[12px] leading-normal">
      {['package.json', 'NestJS + GraphQL', 'Security advisories'].map((layer, i) => (
        <Fragment>
          {i > 0 && <b>↓</b>}
          <span class:list={[
            'max-w-full wrap-anywhere border border-[#95ad8c] p-3 text-center',
            i === 2 ? 'bg-[#c6d6b6] text-brand' : 'bg-brand-soft',
          ]}>{layer}</span>
        </Fragment>
      ))}
    </div>
  )}
  <span class="font-mono text-[8px] leading-normal tracking-[.09em] text-on-brand">{label.flow}</span>
</div>
