---
import { site } from '../../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  about?: Record<string, unknown>;
}

const { title = site.title, description = site.description, noindex = false, about } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const image = new URL('/social-logo.png', site.url).href;
const websiteId = new URL('/#website', site.url).href;
const personId = new URL('/#person', site.url).href;
const person = {
  '@type': 'Person',
  '@id': personId,
  name: site.name,
  url: site.url,
  sameAs: site.profiles.map((profile) => profile.href),
  jobTitle: ['Senior Software Engineer', 'Backend Developer'],
  homeLocation: { '@type': 'Country', name: 'Israel' },
};
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: site.url,
      name: site.name,
      description: site.description,
      author: { '@id': personId },
      inLanguage: 'en',
    },
    person,
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': websiteId },
      inLanguage: 'en',
      about: about ?? { '@id': personId },
    },
  ],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={site.name} />
{noindex && <meta name="robots" content="noindex" />}
<meta name="theme-color" content="#f6f4ee" />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/lielalmog-favicon.svg" type="image/svg+xml" />
{site.profiles.map((profile) => <link rel="me" href={profile.href} />)}
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Liel Almog's nested paths logo and Senior backend engineer title" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
