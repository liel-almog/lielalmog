---
import { site } from '../../data/site';
---

<header class="border-b border-line bg-[#f6f4eef5] sticky top-0 z-[30]">
  <div class="w-[calc(100%-96px)] max-w-site mx-auto max-[1050px]:w-[calc(100%-56px)] max-[760px]:w-[calc(100%-40px)] max-[400px]:w-[calc(100%-32px)] flex items-center justify-between gap-7 min-h-23 max-[760px]:flex-wrap max-[760px]:gap-2 max-[760px]:py-3 max-[760px]:min-h-0">
    <a class="flex min-h-11 items-center gap-3.25 text-[15px] font-[650] leading-[1.4] max-[760px]:text-[13px]" href="/" aria-label="Liel Almog, home">
      <img src="/lielalmog-favicon.svg" width="42" height="42" class="w-10.5 h-10.5 max-[760px]:w-9 max-[760px]:h-9" alt="" aria-hidden="true" />
      <span>Liel Almog<small class="mt-0.75 block font-mono text-[9px] font-normal tracking-[.08em]">BACKEND ENGINEER</small>
      </span>
    </a>
    <nav class="ml-auto mr-7 flex gap-7.5 max-[1050px]:mr-0 max-[1050px]:gap-5 max-[760px]:order-3 max-[760px]:mt-1.25 max-[760px]:w-full max-[760px]:justify-between max-[760px]:gap-1 max-[760px]:border-t max-[760px]:border-line max-[760px]:pt-0.75" aria-label="Primary navigation">
      <a class="flex min-h-11 items-center text-[13px] max-[760px]:min-h-11 max-[760px]:flex-1 max-[760px]:justify-center max-[760px]:text-[12px]" href="/#experience">Experience</a>
      <a class="flex min-h-11 items-center text-[13px] max-[760px]:min-h-11 max-[760px]:flex-1 max-[760px]:justify-center max-[760px]:text-[12px]" href="/#projects">Projects</a>
      <a class="flex min-h-11 items-center text-[13px] max-[760px]:min-h-11 max-[760px]:flex-1 max-[760px]:justify-center max-[760px]:text-[12px]" href="/#expertise">Expertise</a>
      <a class="flex min-h-11 items-center text-[13px] max-[760px]:min-h-11 max-[760px]:flex-1 max-[760px]:justify-center max-[760px]:text-[12px]" href="/#contact">Contact</a>
    </nav>
    <a class="flex min-h-11 items-center text-[13px] border border-[#9ba397] px-4.75 gap-6.25 max-[760px]:hidden" href={site.resume} data-resume-dialog>Resume <span aria-hidden="true">↗</span>
    </a>
    <a class="hidden min-h-11 items-center text-[12px] border border-[#9ba397] px-3 gap-3.75 max-[760px]:ml-auto max-[760px]:flex" href={site.resume} data-resume-dialog>Resume <span aria-hidden="true">↗</span>
    </a>
  </div>
</header>
