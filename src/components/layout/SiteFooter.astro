---
import { site } from '../../data/site';
---

<footer class="border-t border-[#ccd1c5] py-6.25 flex justify-between items-center gap-5 text-[11px] max-[760px]:flex-wrap max-[760px]:gap-[5px_15px] w-[calc(100%-96px)] max-w-site mx-auto max-[1050px]:w-[calc(100%-56px)] max-[760px]:w-[calc(100%-40px)] max-[400px]:w-[calc(100%-32px)]">
  <a class="site-text-link flex min-h-11 items-center gap-1.25" href="/">{site.name} <span class="text-subtle max-[760px]:hidden"> / Senior Backend Engineer</span>
  </a>
  <p class="text-subtle max-[760px]:order-3 max-[760px]:w-full">Thoughtfully engineered. Built with Astro.</p>
  <a class="site-text-link flex min-h-11 items-center gap-1.25 max-[760px]:ml-auto" href="#main-content">Back to top ↑</a>
</footer>
