---
import { site } from '../../data/site';

const previewUrl = new URL('preview', site.resume).href;
---

<dialog
  id="resume-dialog"
  data-resume-url={site.resume}
  aria-labelledby="resume-title"
  class="resume-dialog m-auto max-w-none overflow-hidden border border-line bg-page p-0 text-foreground shadow-2xl backdrop:bg-black/60"
>
  <div class="flex h-full min-h-0 flex-col">
    <div class="grid shrink-0 grid-cols-[minmax(0,1fr)_auto_auto] items-center gap-4 border-b border-line px-5 py-3 max-[760px]:gap-2 max-[760px]:px-3 max-[760px]:py-1.5">
      <h2 id="resume-title" class="min-w-0 text-xl font-semibold max-[760px]:text-base">My resume</h2>
      <a href={site.resume} target="_blank" rel="noopener noreferrer" aria-label="Open PDF in a new tab" class="inline-flex min-h-11 items-center gap-2 whitespace-nowrap text-[13px] font-semibold underline max-[760px]:gap-1 max-[760px]:text-xs">
        <span class="max-[760px]:hidden">Open PDF in a new tab</span><span class="min-[761px]:hidden">Open PDF</span> <span aria-hidden="true">↗</span>
      </a>
      <form method="dialog">
        <button autofocus class="min-h-11 cursor-pointer whitespace-nowrap border border-line px-3 text-[13px] font-semibold max-[760px]:px-2 max-[760px]:text-xs">Close <span aria-hidden="true">×</span></button>
      </form>
    </div>
    <iframe
      data-src={previewUrl}
      title="Liel Almog’s resume PDF"
      class="block min-h-0 min-w-0 w-full flex-1 border-0 bg-page"
    ></iframe>
  </div>
</dialog>

<style>
  .resume-dialog {
    width: min(calc(100% - 32px), 1100px);
    height: 90dvh;
    max-height: calc(100dvh - 32px - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px));
  }

  @media (max-width: 760px) {
    .resume-dialog {
      width: calc(100% - 24px - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px));
      height: min(80dvh, 720px);
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#resume-dialog');
  if (dialog) {
    const viewer = dialog.querySelector('iframe');
    let previousOverflow = '';

    document.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
      if (link.href !== dialog.dataset.resumeUrl || dialog.contains(link)) return;
      link.setAttribute('aria-haspopup', 'dialog');
      link.setAttribute('aria-controls', dialog.id);
      link.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        if (dialog.open) return;
        if (viewer?.dataset.src && !viewer.hasAttribute('src')) {
          viewer.src = viewer.dataset.src;
        }
        previousOverflow = document.documentElement.style.overflow;
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
      });
    });

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = previousOverflow;
    });
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return;
      const bounds = dialog.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right ||
          event.clientY < bounds.top || event.clientY > bounds.bottom) {
        dialog.close();
      }
    });
  }
</script>
