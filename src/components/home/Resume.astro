---
import { site } from '../../data/site';
---

<dialog
  id="resume-dialog"
  aria-labelledby="resume-title"
  tabindex="-1"
  class="m-auto box-border h-[90dvh] max-h-[calc(100dvh_-_32px_-_env(safe-area-inset-top,0px)_-_env(safe-area-inset-bottom,0px))] w-[min(calc(100%_-_32px),1100px)] max-w-none overflow-hidden border border-line bg-page p-0 text-foreground shadow-2xl focus-visible:outline-none backdrop:bg-black/70
    max-[760px]:inset-0 max-[760px]:m-0 max-[760px]:h-dvh max-[760px]:max-h-dvh max-[760px]:w-full max-[760px]:border-0"
>
  <div class="flex h-full min-h-0 flex-col">
    <div class="flex shrink-0 items-center gap-4 border-b border-line bg-page px-5 py-3
      max-[760px]:gap-3 max-[760px]:pt-[calc(12px_+_env(safe-area-inset-top,0px))] max-[760px]:pb-3 max-[760px]:pl-[calc(16px_+_env(safe-area-inset-left,0px))] max-[760px]:pr-[calc(16px_+_env(safe-area-inset-right,0px))]">
      <div class="min-w-0 flex-1">
        <p class="font-mono text-[10px] font-medium leading-none tracking-[.12em] text-accent">LIEL ALMOG / CV</p>
        <h2 id="resume-title" class="mt-1.5 truncate text-xl leading-tight font-semibold max-[760px]:text-[17px]">My resume</h2>
      </div>
      <a href={site.resume} target="_blank" rel="noopener noreferrer" class="site-text-link inline-flex min-h-11 shrink-0 items-center gap-2 whitespace-nowrap text-[13px] leading-none font-semibold max-[760px]:hidden">
        Open PDF in a new tab <span aria-hidden="true">↗</span>
      </a>
      <a href={site.resume} download="Liel-Almog-Resume.pdf" class="site-text-link inline-flex min-h-11 shrink-0 items-center gap-2 whitespace-nowrap text-[13px] leading-none font-semibold max-[760px]:hidden">
        Download CV <span aria-hidden="true">↓</span>
      </a>
      <form method="dialog" class="flex shrink-0 items-center">
        <button aria-label="Close resume" class="inline-flex min-h-11 cursor-pointer items-center justify-center gap-1.5 px-2 text-[13px] leading-none font-semibold text-muted hover:text-foreground"><span>Close</span><span class="text-lg font-normal" aria-hidden="true">×</span></button>
      </form>
    </div>
    <div data-resume-preview class="min-h-0 min-w-0 flex-1 overflow-auto overscroll-contain [-webkit-overflow-scrolling:touch]" role="region" aria-label="Scrollable resume" tabindex="0">
      <template data-resume-image>
        <img
          src={site.resumePreview}
          alt="Liel Almog’s resume"
          decoding="async"
          class="block h-auto w-full bg-white"
        />
      </template>
      <template data-resume-pdf>
        <iframe
          src={`${site.resume}#view=FitH`}
          title="Liel Almog’s resume PDF"
          class="block h-full w-full border-0 bg-page"
        ></iframe>
      </template>
    </div>
    <div class="hidden shrink-0 items-center gap-2 border-t border-line bg-page px-4 py-3
      max-[760px]:flex max-[760px]:pb-[calc(12px_+_env(safe-area-inset-bottom,0px))] max-[760px]:pl-[calc(16px_+_env(safe-area-inset-left,0px))] max-[760px]:pr-[calc(16px_+_env(safe-area-inset-right,0px))]">
      <a href={site.resume} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 min-w-0 flex-1 items-center justify-center gap-1.5 border border-line px-2 text-center text-[12px] leading-tight font-semibold hover:bg-panel">
        Open PDF <span aria-hidden="true">↗</span>
      </a>
      <a href={site.resume} download="Liel-Almog-Resume.pdf" class="inline-flex min-h-12 min-w-0 flex-1 items-center justify-center gap-1.5 border border-brand bg-brand px-2 text-center text-[12px] leading-tight font-semibold text-white hover:bg-brand-hover hover:text-white">
        Download <span aria-hidden="true">↓</span>
      </a>
    </div>
  </div>
</dialog>

<script src="../../scripts/resume-dialog.ts"></script>
