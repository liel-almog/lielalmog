---
import { introVideo } from '../../data/intro-video';
import YouTubeEmbed from '../media/YouTubeEmbed.astro';
---

<section
  class="border-t border-line bg-panel py-16 max-[760px]:py-10"
  id="intro-video"
  aria-labelledby="intro-title"
>
  <div class="mx-auto grid w-[calc(100%-96px)] max-w-site grid-cols-[minmax(0,.85fr)_minmax(0,1.15fr)] items-center gap-x-[8%] gap-y-8 max-[1050px]:w-[calc(100%-56px)] max-[900px]:grid-cols-1 max-[760px]:w-[calc(100%-40px)] max-[400px]:w-[calc(100%-32px)]">
    <div class="min-w-0">
      <p class="mb-4 font-mono text-[.69rem] leading-[1.6] font-medium tracking-[.09em] text-accent uppercase">
        01 / Meet Liel
      </p>
      <h2
        class="text-[clamp(2rem,3.5vw,3rem)] leading-[1.1] font-[550] tracking-[-.045em] wrap-anywhere max-[760px]:text-[clamp(1.75rem,7.5vw,2.75rem)]"
        id="intro-title"
      >
        The person<br />
        <span class="font-serif font-normal italic tracking-[-.055em]">behind the systems.</span>
      </h2>
      <p class="mt-5 max-w-sm text-[15px] leading-[1.85] text-muted max-[760px]:text-[14px]">
        {introVideo.description}
      </p>
    </div>
    <figure class="min-w-0">
      <YouTubeEmbed videoId={introVideo.videoId} title={introVideo.videoTitle} />
      <figcaption class="mt-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
        <span class="font-mono text-[10px] tracking-[.08em] text-muted uppercase">60-second introduction</span>
        <a
          class="site-text-link inline-flex min-h-11 items-center gap-2 text-[12px] font-semibold"
          href={`https://www.youtube.com/watch?v=${introVideo.videoId}`}
        >
          Open on YouTube <span aria-hidden="true">↗</span>
        </a>
      </figcaption>
    </figure>
  </div>
</section>
