---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { experiences } from '../data/experience';
import { skillGroups } from '../data/expertise';
import { projects } from '../data/projects';
import { introVideo } from '../data/intro-video';
import YouTubeEmbed from '../components/media/YouTubeEmbed.astro';
---
<BaseLayout>
  <section class="hero wrap" id="top" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="small-square"></span> Liel Almog · Based in Israel</p>
      <h1 id="hero-title">Senior backend<br/><span class="serif">engineer.</span></h1>
      <p class="hero-statement">Complex systems.<br/>Clear thinking. Dependable software.</p>
      <p class="hero-description">I build APIs, distributed systems, and cloud platforms — and own the work from architecture to production. Engineering across backend and product since 2021.</p>
      <div class="actions"><a class="button primary" href={site.resume}>View resume <span aria-hidden="true">↗</span></a><a class="button" href="#experience">Explore my experience <span aria-hidden="true">↓</span></a></div>
      <div class="hero-links">{site.profiles.map(p => <a href={p.href}>{p.name} <span aria-hidden="true">↗</span></a>)}<a href={`mailto:${site.email}`}>Email me <span aria-hidden="true">↗</span></a></div>
    </div>
    <aside class="system-sheet" aria-labelledby="system-title">
      <div class="sheet-top"><span>ENGINEERING PROFILE</span><span>01 / LA</span></div>
      <h2 id="system-title">Built beneath<br/>the surface.</h2>
      <p class="sheet-caption">My focus, across the system.</p>
      <ol class="system-layers">
        <li><span class="layer-number">01</span><div><strong>Services & APIs</strong><small>Go / Python / TypeScript</small></div><span aria-hidden="true">↗</span></li>
        <li><span class="layer-number">02</span><div><strong>Distributed systems</strong><small>Concurrency / Events / Data</small></div><span aria-hidden="true">↗</span></li>
        <li><span class="layer-number">03</span><div><strong>Cloud & platforms</strong><small>Azure / Kubernetes / OpenShift</small></div><span aria-hidden="true">↗</span></li>
      </ol>
      <div class="sheet-bottom"><span class="small-square"></span> Architecture → Delivery → Operation</div>
    </aside>
  </section>
  <div class="focus-strip"><div class="wrap"><span>BACKEND FIRST. SYSTEMS MINDED.</span><p>Reliable APIs <b> / </b> Data consistency <b> / </b> Platform engineering <b> / </b> Complete delivery</p></div></div>
  <section class="section wrap" id="experience" aria-labelledby="experience-title">
    <div class="section-heading"><div><p class="eyebrow">01 / Professional experience</p><h2 id="experience-title">Growing scope.<br/><span class="serif">Deeper ownership.</span></h2></div><p>From cloud applications to internal platforms and resource allocation systems. A career built around making complex software work in production.</p></div>
    <div class="experience-list">{experiences.map((role,index) => <article class="experience-row">
      <div class="role-date"><span class="eyebrow">{index === 0 ? 'CURRENT ROLE' : `0${index + 1}`}</span><p><time datetime={role.start.date}>{role.start.label}</time> —<br/>{role.end ? <time datetime={role.end.date}>{role.end.label}</time> : 'Present'}</p></div>
      <div class="role-main"><h3>{role.title}</h3><p class="role-focus">{role.focus}</p><p>{role.summary}</p><ul class="highlights">{role.highlights.map(h => <li>{h}</li>)}</ul></div>
      <div class="role-stack"><p class="eyebrow">Stack & systems</p><ul class="tags">{role.technologies.map(t => <li>{t}</li>)}{'services' in role && role.services.map(t => <li>{t}</li>)}</ul></div>
    </article>)}</div>
    <a class="text-link" href={site.resume}>View full resume <span aria-hidden="true">↗</span></a>
  </section>
  <section class="projects-band" id="projects" aria-labelledby="projects-title"><div class="wrap section">
    <div class="section-heading"><div><p class="eyebrow">02 / Selected projects</p><h2 id="projects-title">An instinct to<br/><span class="serif">go deeper.</span></h2></div><p>From a Go API to the Linux kernel: working systems that explore security, algorithms, and the tools developers depend on.</p></div>
    <div class="project-list">{projects.map((project,index) => <article class="project-card">
      <div class="project-art" aria-hidden="true">
        <div class="art-caption"><span>0{index+1} / SYSTEM STUDY</span><span>{index === 0 ? 'SECURITY' : index === 1 ? 'ALGORITHMS' : 'DEVELOPER TOOLS'}</span></div>
        {index === 0 ? <div class="shield-diagram"><div>CONTROL PLANE</div><span>↓</span><div>GO HOST AGENT</div><span>↓</span><div class="kernel">C / eBPF KERNEL</div></div> : index === 1 ? <div class="puzzle">{['1','2','3','4','5','6','7','8','↗'].map(n => <span>{n}</span>)}</div> : <div class="dependency-diagram"><span>package.json</span><b>↓</b><span>NestJS + GraphQL</span><b>↓</b><span class="advisory">Security advisories</span></div>}
        <span class="art-footer">{index === 0 ? 'POLICY → ENFORCEMENT' : index === 1 ? 'INPUT → SEARCH → SOLUTION' : 'DEPENDENCIES → KNOWN RISKS'}</span>
      </div>
      <div class="project-copy"><p class="eyebrow">{project.category}</p><h3><a href={`/projects/${project.id}/`}>{project.name}</a></h3><p>{project.summary}</p><ul class="tags">{project.technologies.map(t => <li>{t}</li>)}</ul><div class="project-actions"><a class="text-link" href={`/projects/${project.id}/`}>Read case study <span aria-hidden="true">→</span><span class="sr-only">: {project.name}</span></a><a href={project.href}>{project.linkLabel} <span aria-hidden="true">↗</span></a></div></div>
    </article>)}</div>
  </div></section>
  <section class="section wrap" id="expertise" aria-labelledby="expertise-title">
    <div class="section-heading"><div><p class="eyebrow">03 / Technical strengths</p><h2 id="expertise-title">Backend depth.<br/><span class="serif">System-wide perspective.</span></h2></div><p>I choose tools around the system’s constraints, with the range to connect infrastructure, services, and the product experience.</p></div>
    <div class="expertise-grid">{skillGroups.map((group,index) => <article><span class="eyebrow">0{index+1}</span><h3>{group.title}</h3><p>{group.description}</p><ul class="tags">{group.technologies.map(t => <li>{t}</li>)}</ul></article>)}</div>
  </section>
  <section class="intro-band" id="intro-video" aria-labelledby="intro-title"><div class="wrap intro-grid"><div><p class="eyebrow">04 / Meet Liel</p><h2 id="intro-title">The person<br/><span class="serif">behind the systems.</span></h2><p>{introVideo.description}</p><a class="text-link" href={`https://www.youtube.com/watch?v=${introVideo.videoId}`}>Watch my 60-second intro <span aria-hidden="true">↗</span></a></div><YouTubeEmbed videoId={introVideo.videoId} title={introVideo.videoTitle}/></div></section>
  <section class="contact wrap section" id="contact" aria-labelledby="contact-title"><div><p class="eyebrow">05 / Get in touch</p><h2 id="contact-title">Let’s build<br/><span class="serif">something dependable.</span></h2><p>Hiring a senior backend engineer? Let’s talk about your team and the systems you’re building.</p></div><div class="contact-links"><a href={`mailto:${site.email}`}><small>EMAIL</small><span>{site.email} ↗</span></a>{site.profiles.map(p => <a href={p.href}><small>{p.name.toUpperCase()}</small><span>{p.name === 'GitHub' ? 'Explore my code' : 'Let’s connect'} ↗</span></a>)}<a href={site.resume}><small>RESUME</small><span>View my experience ↗</span></a></div></section>
</BaseLayout>
