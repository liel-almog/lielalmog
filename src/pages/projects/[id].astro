---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
import ArchitectureDiagram from '../../components/projects/ArchitectureDiagram.astro';

// Only known projects generate pages; unmatched URLs use the site's 404 page.
export const getStaticPaths = (() => {
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { project } = Astro.props;
const title = `${project.seoTitle} | Liel Almog`;
const relatedProjects = projects.filter((item) => item.id !== project.id);
const structuredData = {
  '@type': project.schemaType,
  name: project.name,
  description: project.summary,
  url: project.href,
  ...(project.repositoryUrl ? { codeRepository: project.repositoryUrl } : {}),
  creator: { '@id': 'https://lielalmog.com/#person' },
};
---

<BaseLayout
  title={title}
  description={project.seoDescription}
  about={structuredData}
>
  <article class="mx-auto w-[calc(100%-2.5rem)] max-w-site py-[clamp(3rem,7vw,6rem)]">
    <nav aria-label="Breadcrumb" class="mb-8 text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a class="text-accent hover:text-accent-bright" href="/">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a class="text-accent hover:text-accent-bright" href="/#projects">Projects</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">{project.name}</li>
      </ol>
    </nav>

    <header class="max-w-4xl">
      <p class="mb-4 font-mono text-xs tracking-[0.12em] text-accent uppercase">{project.category}</p>
      <h1 class="font-display text-[clamp(2.7rem,6vw,5.5rem)] leading-[1.02] font-bold tracking-[-0.06em]">
        {project.name}
      </h1>
      <p class="mt-7 max-w-3xl text-[clamp(1.1rem,2vw,1.4rem)] leading-relaxed text-muted">
        {project.summary}
      </p>
      <a
        class="mt-7 inline-flex min-h-11 items-center gap-2 rounded-sm border border-accent bg-accent px-5 py-2 text-sm font-bold text-page hover:bg-accent-bright"
        href={project.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        {project.linkLabel} <span aria-hidden="true">↗</span>
      </a>
    </header>

    <div class="mt-14 grid gap-10 border-t border-line pt-10 md:grid-cols-[minmax(0,1.35fr)_minmax(14rem,0.65fr)]">
      <section aria-labelledby="motivation-title">
        <h2 id="motivation-title" class="text-2xl font-bold tracking-[-0.035em]">Why I built it</h2>
        <p class="mt-4 leading-8 text-muted">{project.motivation}</p>
        <h2 class="mt-10 text-2xl font-bold tracking-[-0.035em]" id="approach-title">Engineering approach</h2>
        {project.approach.map((paragraph) => (
          <p class="mt-4 leading-8 text-muted">{paragraph}</p>
        ))}
      </section>
      <aside class="rounded-xl border border-line bg-surface/45 p-6" aria-label="Project technologies and concepts">
        <h2 class="text-lg font-bold">Technologies & concepts</h2>
        <ul class="mt-5 flex flex-wrap gap-2">
          {project.technologies.map((technology) => (
            <li class="rounded-md border border-line bg-page/55 px-2.5 py-1 text-xs leading-5 text-muted">
              {technology}
            </li>
          ))}
        </ul>
      </aside>
    </div>

    <section class="mt-14 border-t border-line pt-10" aria-labelledby="architecture-title">
      <h2 id="architecture-title" class="text-2xl font-bold tracking-[-0.035em]">How {project.name} works</h2>
      <p class="mt-4 max-w-3xl leading-8 text-muted">Explore the main parts of the project and how they fit together.</p>
      <ArchitectureDiagram project={project} />
    </section>

    <nav class="mt-16 border-t border-line pt-10" aria-label="More projects">
      <h2 class="text-2xl font-bold tracking-[-0.035em]">Explore more projects</h2>
      <ul class="mt-5 flex flex-wrap gap-x-8 gap-y-3">
        {relatedProjects.map((related) => (
          <li>
            <a class="text-accent hover:text-accent-bright" href={`/projects/${related.id}/`}>
              {related.name} <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </article>
</BaseLayout>
